# Core infrastructure
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ventrueadvisor
REDIS_URL=redis://localhost:6379
STORAGE_ROOT=./storage
API_PORT=3000

# Local database and Redis container defaults
POSTGRES_DB=ventrueadvisor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379

# Telegram control plane secrets
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-me
TELEGRAM_WEBHOOK_PORT=3001
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
TELEGRAM_OPERATOR_USER_IDS=
GATEWAY_API_BASE_URL=http://localhost:3000
GATEWAY_API_AUTH_TOKEN=

# Worker runtime
COPILOT_RUNTIME_MODE=deterministic-local-runtime
COPILOT_CLI_PATH=
COPILOT_USE_LOGGED_IN_USER=true
GITHUB_TOKEN=
AGENT_TIMEOUT_MS=300000
REPORT_RENDER_TIMEOUT_MS=60000
PRD_GENERATION_TIMEOUT_MS=120000
POC_GENERATION_TIMEOUT_MS=120000

# Workflow thresholds and routing policy
JUDGE_VC_PASS_THRESHOLD=7.5
JUDGE_EVIDENCE_PASS_THRESHOLD=7.0
VC_PASS_THRESHOLD=7.5
EVIDENCE_PASS_THRESHOLD=7.0
MIN_SCORE_IMPROVEMENT=0.4
DEFAULT_MAX_ITERATIONS=3
COMPLEX_TOPIC_MAX_ITERATIONS=5
MAX_STAGNANT_ITERATIONS=2
DEFAULT_RESEARCH_STYLE=BALANCED
BROWSING_AUTONOMY_PROFILE=STANDARD
BROWSING_ALLOW_ADJACENT_EXPLORATION=false
BROWSING_ALLOW_COMPETITOR_EXPLORATION=true
BROWSING_ALLOW_OPEN_ENDED_QUERIES=false
BROWSING_MAX_SOURCES_PER_QUERY=5
BROWSING_RECENCY_WINDOW_DAYS=120
PREFER_TERMINAL_DECISION_BY_ITERATION=3
REJECT_ON_CONSECUTIVE_STAGNATION=true
REJECT_ON_TERMINATION_WARNING_NEXT_WEAK_ITERATION=true
REJECT_ON_UNRESOLVED_FATAL_FLAWS=true
ALLOW_REVISE_ON_FATAL_FLAW_WITH_DISPROOF_PATH=true
REQUIRE_JUDGE_PASS_FOR_PASS_ROUTING=true
REQUIRE_PASS_FOR_DOWNSTREAM_GENERATION=true
